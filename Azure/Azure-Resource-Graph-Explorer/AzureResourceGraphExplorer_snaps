resources
| where type =~ 'microsoft.compute/snapshots'
| join kind=leftouter (
    resourcecontainers
    | where type =~ 'microsoft.resources/subscriptions'
    | project subscriptionName = name, subscriptionId, tenantId
) on subscriptionId
| extend azureRegion = location
| extend azureZone = strcat_array(zones, '"')
| extend resourceId = tolower(tostring(id))
| extend resourceName = name
| extend skuName = tostring(sku.name)
| extend skuTier = tostring(sku.tier)
| extend sourceDisk = tostring(properties.creationData.sourceResourceId)
| extend osType = tostring(properties.osType)
| extend incremental = tostring(properties.incremental)
| extend diskSizeGB = tostring(properties.diskSizeGB)
| extend creationTime = properties.timeCreated
| where isnull(properties.osType)
| project azureRegion, azureZone, name, subscriptionName, tenantId, resourceGroup, resourceId, resourceName, 
          skuName, skuTier, sourceDisk, osType, diskSizeGB, incremental, creationTime

